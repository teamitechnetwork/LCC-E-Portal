{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build && PORT=5173 BASE_PATH=/ pnpm --filter @workspace/lcc-e-portal run build",
  "outputDirectory": "artifacts/lcc-e-portal/dist/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 10
    },
    "api/[...path].mjs": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}